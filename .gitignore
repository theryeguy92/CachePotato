build/
weights/*
data/*
!weights/.gitkeep
!data/.gitkeep
__pycache__/
.venv/
*.o

# experiments/ holds Phase 0 scratch programs. The sources are tracked; the
# compiled binaries produced by experiments/Makefile are not. A blanket
# experiments/ rule would ignore the sources too, so target the *binaries*.
experiments/mmap_basics
experiments/madvise_hints
experiments/ssd_latency

# bench drivers write scratch files next to their results
bench/results/**/.*

# scratch/ holds generated intermediates (permuted weight files are ~735MB).
# Reports worth keeping are copied into bench/results/layout/.
scratch/

# calibration probe test file: must exceed RAM to be meaningful (tens of GB)
scratch/big.bin

# generated CPW1 v4 test files (hundreds of MB; regenerate with tools/v3_to_v4.py)
scratch/*.v4cp
